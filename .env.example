# Leave both values empty when the remote GPU service is not deployed yet.
CATVTON_API_URL=http://10.0.0.20:9002
CATVTON_API_KEY=use-the-same-secret-as-catvton
OPENAI_API_KEY=
CATALOG_CURRENCY=INR
# Use /data/hm_image when the H&M image folder is the active catalog.
IMAGE_DIR=/data/images
ARTICLE_EXTRACTION_MODEL=gpt-4.1-mini
QUERY_PLANNER_MODEL=gpt-4.1-mini
AESTHETIC_REVIEW_MODEL=gpt-4.1-mini
AESTHETIC_REVIEW_ENABLED=true
ARTICLE_ALLOWED_DOMAINS=elle.com,www.elle.com,gq.com.tw,www.gq.com.tw,marieclairekorea.com,www.marieclairekorea.com,gqkorea.co.kr,www.gqkorea.co.kr
