# One credential and one public entry point cover both GPU APIs.
TRYON_API_KEY=replace-with-a-long-random-secret
MINIO_ROOT_USER=replace-with-a-private-access-key
MINIO_ROOT_PASSWORD=replace-with-a-long-random-secret
CLOUDFLARE_TUNNEL_TOKEN=replace-with-your-cloudflare-tunnel-token

# Human3D starts only with --profile human3d.
HUMAN3D_MODEL_ID=LHMPP-700M-PixelShuffle
HUMAN3D_MODEL_PATH=
HUMAN3D_JOB_TTL_HOURS=24

# auto first measures whether both models safely fit. Use switch to force lazy loading.
GPU_RESIDENCY_MODE=auto
GPU_VRAM_SAFETY_MARGIN_GB=1.5

# Local-only gateway defaults. Cloudflare should target http://gateway:8080.
GPU_GATEWAY_BIND_ADDRESS=127.0.0.1
GPU_GATEWAY_PORT=9001
